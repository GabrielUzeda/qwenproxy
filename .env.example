# =============================================================================
# QwenProxy — configuração essencial (perfil ROBUSTO por padrão)
# Copie para .env e ajuste conforme necessário.
# =============================================================================

# Server
PORT=3000
HOST=0.0.0.0

# Proxy API key. Leave empty to allow unauthenticated requests.
# AUTH_REQUIRED=false abaixo; se exposto para a internet, defina uma API_KEY
# forte aqui (a dashboard admin usa ADMIN_PASSWORD ou fallback para API_KEY).
API_KEY=
# Require auth on /v1/* endpoints (middleware also honors API_KEY presence).
AUTH_REQUIRED=false

# Qwen credentials for automatic login/account rotation.
QWEN_EMAIL=
QWEN_PASSWORD=

# Set to 'true' to bypass account rotation and use only guest mode.
QWEN_GUEST_MODE_ONLY=false

# Qwen endpoints.
QWEN_BASE_URL=https://chat.qwen.ai
QWEN_HTTP_ENDPOINT=https://api.qwen.ai/v1/chat

# Optional Qwen API key when using the HTTP endpoint.
QWEN_API_KEY=

# Browser configuration.
BROWSER=chromium
HEADLESS=true
USER_DATA_DIR=./qwen_profiles
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
LOG_CONSOLE=false

# ---------------------------------------------------------------------------
# Anti-bot / latência — perfil robusto
# ---------------------------------------------------------------------------
# Headers TTL mantêm a sessão viva (30min); o refresh em background evita
# headers velhos com TMD sem custo no primeiro request.
HEADERS_TTL_MS=1800000
BACKGROUND_HEADER_REFRESH=true

# Warm pool elimina a criação de chat por request (~800–2000ms de TTFT).
WARM_POOL_SIZE=3
WARM_POOL_LOW_WATER=2
WARM_POOL_TTL_MS=600000
WARM_POOL_STARTUP=true

# Session keeper renova cookies/headers periodicamente para evitar sessões
# expiradas em produção.
SESSION_KEEPER_ENABLED=true

# Boot seguro: poucas contas de cada vez + stagger para não tomar 429 na subida.
ACCOUNT_INIT_CONCURRENCY=2
ACCOUNT_INIT_STAGGER_MIN_MS=250
ACCOUNT_INIT_STAGGER_MAX_MS=800

# Pré-captura headers no boot (primeiro request sem custo de interceptação).
PRECAPTURE_HEADERS_STARTUP=true
PRECAPTURE_HEADERS_CONCURRENCY=1
PRECAPTURE_HEADERS_STAGGER_MIN_MS=2500
PRECAPTURE_HEADERS_STAGGER_MAX_MS=5000

# Use one configured account split into isolated browser contexts for concurrency.
# ACCOUNT_LANES > 1 desativa a serialização por conta (concorrência real).
SINGLE_ACCOUNT_MODE=false
SINGLE_ACCOUNT_ID=
SINGLE_ACCOUNT_EMAIL=
ACCOUNT_LANES=2

# Max concurrent streams per REAL Qwen account. All lanes of one account share
# this single budget, so lanes beyond it do NOT increase throughput — they only
# burn browser resources and trip Qwen's per-account rate limits (429). Start at
# 2-3, raise only if you see queuing with no 429s.
ACCOUNT_MAX_CONCURRENT_STREAMS=2
# How long a request waits for a free stream slot before becoming retryable
# (the router then tries another account / lane).
ACCOUNT_STREAM_SLOT_WAIT_MS=30000

# Direct completions fast path: POST from Node with the captured anti-bot
# headers, bypassing the CDP stream relay (much lower latency/TTFT and higher
# throughput per account). Falls back to the browser relay on TMD challenges;
# a per-account circuit breaker disables it for 5min after 3 failures.
QWEN_DIRECT_FETCH=true

# ---------------------------------------------------------------------------
# Timeouts (ms) — robustos: toleram upstream lento sem derrubar a geração
# ---------------------------------------------------------------------------
NAVIGATION_TIMEOUT=90000
PAGE_TIMEOUT=60000
HTTP_TIMEOUT=45000
HEADERS_TIMEOUT=90000
CHAT_TIMEOUT=120000
STREAM_IDLE_TIMEOUT=180000

# Cache TTL values (seconds).
CACHE_TTL=3600
RESPONSE_TTL=1800

# Metrics collection interval (milliseconds).
METRICS_INTERVAL=10000

# ---------------------------------------------------------------------------
# Watchdog — memória por RSS (% do sistema) e streams
# ---------------------------------------------------------------------------
WATCHDOG_INTERVAL=5000
WATCHDOG_FAILURES=3
RAM_WARNING=70
RAM_CRITICAL=90
WS_WARNING=40
WS_CRITICAL=80

# ---------------------------------------------------------------------------
# Hybrid sessions (economia de contexto + consistência)
# ---------------------------------------------------------------------------
# Sessões persistentes (SQLite) com envio econômico e verificação amortizada.
HYBRID_SESSIONS_ENABLED=true
HYBRID_SESSION_VERIFY=true
HYBRID_SESSION_VERIFY_EVERY_MS=60000
HYBRID_SESSION_TTL_MS=86400000
# Guard degenerado no streaming: prone (default) | always | off
STREAM_DEGENERATE_GUARD=prone

# ---------------------------------------------------------------------------
# Multi-user (API keys com cotas)
# ---------------------------------------------------------------------------
USER_RATE_LIMIT_RPM=120
USER_MAX_CONCURRENCY=8
USER_API_KEYS=

# Admin dashboard password (GET /admin). Falls back to API_KEY when unset.
ADMIN_PASSWORD=